command[observatory_check_load]=/usr/lib/nagios/plugins/check_load -w 5,4,3 -c 10,6,4
command[observatory_check_disk_root]=/usr/lib/nagios/plugins/check_disk -w 20% -c 10% -p /
command[observatory_check_memory]=/usr/local/lib/nagios/plugins/check_memory.py --warning {{ nagios_memory_warning }} --critical {{ nagios_memory_critical }}
